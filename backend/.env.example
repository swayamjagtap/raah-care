# Supabase PostgreSQL connection
DATABASE_URL=""

# Direct PostgreSQL connection used by Prisma CLI/migrations
DIRECT_URL=""

# Optional runtime port (defaults to 3000)
PORT=3000

# Supabase Auth JWT Verification:
# For asymmetric ES256 tokens (default on modern Supabase projects), set the project URL to fetch JWKS:
SUPABASE_URL="https://ddhtnwgsdwzgibkqbqcx.supabase.co"
# Optional explicit JWKS URL (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json):
# SUPABASE_JWKS_URL=""

# Supabase Auth JWT Secret for legacy HS256 token verification (from Supabase Project Settings -> API):
SUPABASE_JWT_SECRET=""

# Comma-separated list of allowed frontend origins for CORS (e.g. https://app.raah.care,https://admin.raah.care)
FRONTEND_ORIGINS=""

# Cura Card base URL for ephemeral QR token payload (defaults to http://localhost:5173)
CURA_CARD_BASE_URL="http://localhost:5173"

